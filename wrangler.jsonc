{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceuta-nos-une",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",

  // Dominio propio. custom_domain crea y mantiene el registro DNS por nosotros.
  // Se mantiene activa como respaldo mientras el dominio propaga.
  "workers_dev": true,

  "routes": [
    { "pattern": "ceutanosune.com", "custom_domain": true },
    { "pattern": "www.ceutanosune.com", "custom_domain": true }
  ],

  // El Worker sirve la web estática y la API desde el mismo origen.
  // El cruce con porceuta.es se rehace cada hora en punto. Cuesta unos 18 ms
  // de CPU, que en una peticion normal seria mucho y en un cron no es nada.
  "triggers": { "crons": ["0 * * * *"] },

  // El feed del directo lo piden miles de personas cada pocos segundos con la
  // misma URL. Esto hace dos cosas que el Cache API no hace: junta las peticiones
  // que llegan a la vez (una ejecucion, no doscientas) y, cuando acierta, ni
  // siquiera arranca el Worker.
  "cache": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/img/*", "/tiles/*", "/lugares", "/llms.txt", "/lugares.csv", "/sitemap.xml", "/d/*", "/hoja/*", "/embed"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ceuta-nos-une",
      "database_id": "d1e0ef80-cce4-4344-9fe1-316065f7774d",
      "migrations_dir": "./migrations"
    }
  ],

  // Correo de aviso: envío nativo de Cloudflare, sin proveedores externos.
  "send_email": [{ "name": "EMAIL" }],

  // Clasifica lo que sube la gente antes de que salga en pantalla.
  "ai": { "binding": "AI" },

  // El aforo. En memoria, sin escribir en D1: ver src/aforo.ts.
  "durable_objects": {
    "bindings": [{ "name": "AFORO", "class_name": "Aforo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Aforo"] }],

  "vars": {
    "EMAIL_FROM": "avisos@avisos.ceutanosune.com",
    "EMAIL_FROM_NAME": "Ceuta nos une"
  },

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "ceuta-nos-une-fotos"
    }
  ],

  // Anti-spam: los mensajes se publican sin moderacion, asi que el limite es la
  // primera linea de defensa junto con Turnstile (opcional) y el panel de admin.
  "ratelimits": [
    { "name": "RL_MESSAGES", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PLACES", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_GEOCODE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_REPORTS", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_LIKES", "namespace_id": "1006", "simple": { "limit": 40, "period": 60 } },
    // El directo va por persona (ip + ficha), no por IP a secas: las operadoras
    // moviles reparten la misma IPv4 entre muchos clientes, y con clave por IP
    // seis personas en la misma plaza se bloquearian entre ellas.
    { "name": "RL_DIRECTO", "namespace_id": "1007", "simple": { "limit": 8, "period": 60 } },
    { "name": "RL_LATIDO", "namespace_id": "1008", "simple": { "limit": 10, "period": 60 } },
    // Y encima un tope amplio solo por red, como red de seguridad contra un bucle.
    { "name": "RL_RED", "namespace_id": "1009", "simple": { "limit": 240, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
